# Upstash Redis — установится автоматически, если подключить
# Vercel Marketplace → Storage → Upstash Redis (1 клик).
# Локально: создай бесплатную базу на upstash.com и скопируй REST URL/Token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Также поддерживаются переменные с префиксом KV_ (от Vercel KV).
# Можно использовать вместо UPSTASH_*.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Пароль для входа в /admin
ADMIN_PASSWORD=changeme
